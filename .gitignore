# --- macOS / OS cruft ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.orig
*.tmp

# --- Secrets & local-only overrides (do NOT commit real credentials) ---
# Keep committed manifests as templates with placeholders; put filled-in
# secret values in files using the ".local." suffix so they stay out of git
# (e.g. my-secrets.local.yml). NOTE: only the ".local." form is ignored — a
# hyphen like "ingress-local.yml" is a normal, committed filename.
*.local.yml
*.local.yaml
secrets.env
.env
.env.*

# --- TLS certificates / private keys (created for the ingress, per example/ingress) ---
*.key
*.crt
*.pem
*.pfx
*.p12

# --- Kubernetes tooling ---
kubeconfig
*.kubeconfig
# Rendered / built output (e.g. `kubectl kustomize . > rendered.yaml`)
rendered.yaml
rendered.yml
*.rendered.yaml
*.rendered.yml

# --- Helm (if ever added) ---
charts/
*.tgz
